{
    "name": "obsidian-graph-in-vscode",
    "displayName": "Obsidian Graph View in VSCode",
    "description": "Shows an Obsidian vault's Markdown links as an interactive graph.",
    "version": "1.0.0",
    "publisher": "GauravPatidar",
    "author": {
        "name": "Gaurav Patidar"
    },
    "license": "MIT",
    "keywords": [
        "obsidian",
        "graph",
        "graph view",
        "knowledge graph",
        "markdown",
        "wiki links",
        "notes",
        "vault"
    ],
    "icon": "public/icon.png",
    "galleryBanner": {
        "color": "#1e1533",
        "theme": "dark"
    },
    "pricing": "Free",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "activationEvents": [
        "onCommand:obsidianVaultGraph.open",
        "onCommand:obsidianVaultGraph.chooseVault",
        "onCommand:obsidianVaultGraph.refresh",
        "onLanguage:markdown"
    ],
    "main": "./extension.js",
    "scripts": {
        "check": "node --check extension.js && node --check src/extension.js && node --check src/graph-panel.js && node --check src/graph-view.js && node --check src/graph-webview.js && node --check src/vault-index.js && node --check src/wiki-links.js && node --check media/graph.js",
        "test": "mocha test/**/*.test.js",
        "package": "vsce package --no-dependencies",
        "format": "prettier --write \"**/*.{ts,js,json,md}\""
    },
    "contributes": {
        "commands": [
            {
                "command": "obsidianVaultGraph.open",
                "title": "Obsidian Graph View: Open Graph View"
            },
            {
                "command": "obsidianVaultGraph.chooseVault",
                "title": "Obsidian Graph View: Choose Folder or Markdown File"
            },
            {
                "command": "obsidianVaultGraph.refresh",
                "title": "Obsidian Graph View: Refresh Graph"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "obsidianGraphView",
                    "title": "Obsidian Graph",
                    "icon": "public/activitybar-icon.svg"
                }
            ]
        },
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "obsidianVaultGraph.explorerView",
                    "name": "Obsidian Graph"
                }
            ],
            "obsidianGraphView": [
                {
                    "type": "webview",
                    "id": "obsidianVaultGraph.activityView",
                    "name": "Graph View"
                }
            ]
        },
        "configuration": {
            "title": "Obsidian Graph View",
            "properties": {
                "obsidianVaultGraph.vaultPath": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to the folder or Markdown file displayed by the graph."
                },
                "obsidianVaultGraph.excludeDirectories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional directories to exclude from the graph (e.g., ['archive', 'templates']). Default exclusions (.git, .obsidian, node_modules) are always applied."
                },
                "obsidianVaultGraph.maxFiles": {
                    "type": "number",
                    "default": 10000,
                    "minimum": 100,
                    "maximum": 100000,
                    "description": "Maximum number of Markdown files to process in the vault. Prevents performance issues with very large vaults."
                }
            }
        }
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^3.9.2",
        "mocha": "^10.7.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gaurav7902/obsidian-graph-in-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/gaurav7902/obsidian-graph-in-vscode/issues"
    },
    "homepage": "https://github.com/gaurav7902/obsidian-graph-in-vscode#readme"
}
